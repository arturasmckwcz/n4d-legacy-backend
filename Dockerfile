FROM python:3.12-slim

ARG DJANGO_SECRET_KEY
ARG DEBUG
ARG AWS_SES_ACCESS_KEY_ID
ARG AWS_SES_SECRET_ACCESS_KEY
ARG AWS_SES_REGION_NAME
ARG AWS_SES_FROM_EMAIL
ARG DOMAIN
ARG SITE_NAME
ARG CORS_ALLOW_HEADERS
ARG POSTGRES_HOST
ARG NOTION_SECRET
ARG NOTION_OPPORTUNITIES_ID
ARG NOTION_VOLUNTEERS_ID
ARG GLITCHTIP_DSN
ARG CELERY_BROKER_URL
ARG CELERY_RESULT_BACKEND
ARG ALFRED_LAST_COMMIT_HASH
ARG ENVIRONMENT


ENV DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY}
ENV DEBUG=${DEBUG}
ENV AWS_SES_ACCESS_KEY_ID=${AWS_SES_ACCESS_KEY_ID}
ENV AWS_SES_SECRET_ACCESS_KEY=${AWS_SES_SECRET_ACCESS_KEY}
ENV AWS_SES_REGION_NAME=${AWS_SES_REGION_NAME}
ENV AWS_SES_FROM_EMAIL=${AWS_SES_FROM_EMAIL}
ENV DOMAIN=${DOMAIN}
ENV SITE_NAME=${SITE_NAME}
ENV CORS_ALLOW_HEADERS=${CORS_ALLOW_HEADERS}
ENV POSTGRES_HOST=${POSTGRES_HOST}
ENV NOTION_SECRET=${NOTION_SECRET}
ENV NOTION_OPPORTUNITIES_ID=${NOTION_OPPORTUNITIES_ID}
ENV NOTION_VOLUNTEERS_ID=${NOTION_VOLUNTEERS_ID}
ENV GLITCHTIP_DSN=${GLITCHTIP_DSN}
ENV CELERY_BROKER_URL=${CELERY_BROKER_URL}
ENV CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND}
ENV ALFRED_LAST_COMMIT_HASH=${ALFRED_LAST_COMMIT_HASH}
ENV ENVIRONMENT=${ENVIRONMENT}

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /app

RUN apt update -y && apt upgrade -y

RUN apt-get install -y postgresql-client curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY . /app/

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
